# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#f8f8f2"

# Title color for boxes
theme[title]="#f8f8f2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8E90E8"

# Background color of selected item in processes box
theme[selected_bg]="#ff79c6"

# Foreground color of selected item in processes box
theme[selected_fg]="#f8f8f2"

# Color of inactive/disabled text
theme[inactive_fg]="#44475a"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#f8f8f2"

# Background color of the percentage meters
theme[meter_bg]="#44475a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#bd93f9"

# Cpu box outline color
theme[cpu_box]="#F2A2D6"

# Memory/disks box outline color
theme[mem_box]="#F2A2D6"

# Net up/down box outline color
theme[net_box]="#F2A2D6"

# Processes box outline color
theme[proc_box]="#F2A2D6"

# Box divider line and small boxes line color
theme[div_line]="#44475a"

# Temperature graph colors
theme[temp_start]="#bd93f9"
theme[temp_mid]="#ff79c6"
theme[temp_end]="#ff33a8"

# CPU graph colors
theme[cpu_start]="#8E90E8"
theme[cpu_mid]="#F2A2D6"
theme[cpu_end]="#F8F8F2"

# Mem/Disk free meter
theme[free_start]="#8EFDF3"
theme[free_mid]="#8EFDF3"
theme[free_end]="#8EFDF3"

# Mem/Disk cached meter
theme[cached_start]="#8EFDF3"
theme[cached_mid]="#8EFDF3"
theme[cached_end]="#8EFDF3"

# Mem/Disk available meter
theme[available_start]="#8EFDF3"
theme[available_mid]="#8EFDF3"
theme[available_end]="#8EFDF3"

# Mem/Disk used meter
theme[used_start]="#8EFDF3"
theme[used_mid]="#8EFDF3"
theme[used_end]="#8EFDF3"

# Upload graph colors
theme[upload_start]="#8E90E8"
theme[upload_mid]="#F2A2D6"
theme[upload_end]="#F2A2D6"

# Download graph colors
theme[download_start]="#569CD6"
theme[download_mid]="#8EFDF3"
theme[download_end]="#8EFDF3"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#F2A2D6"
theme[process_mid]="#59b690"
theme[process_end]="#6272a4"
